# ============================================================================
# MandateZ Consumer — environment variables
# Copy to .env.local (dev) or set in Vercel project settings (prod).
# ============================================================================

# --- Supabase (server-side) -------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (browser-side) ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sentry -----------------------------------------------------------------
# DSN is browser-exposed; org/project are build-time only (source map upload).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
