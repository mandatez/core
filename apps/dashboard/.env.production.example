# ============================================================================
# MandateZ Dashboard — production environment variables
# Copy to .env.local (dev) or set in Vercel project settings (prod).
# ============================================================================

# --- Supabase (server-side, never exposed to browser) -----------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (browser-side, prefixed NEXT_PUBLIC_) -------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App URLs ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DASHBOARD_URL=

# --- Compliance reports (Resend) --------------------------------------------
# Free tier: 3000 emails/mo at resend.com
RESEND_API_KEY=
RESEND_FROM_ADDRESS=MandateZ Reports <onboarding@resend.dev>

# --- Vercel cron auth -------------------------------------------------------
# Required: /api/schedules/trigger fails closed if this is unset.
CRON_SECRET=

# --- Platform attestation keys (Ed25519, base64-ORIGINAL) -------------------
# Required in production. Without these, attestation signing falls back to a
# publicly-known dev seed (the production guard refuses to boot in that case).
# Generate a fresh keypair with: node -e "require('libsodium-wrappers').ready.then(()=>{const k=require('libsodium-wrappers').crypto_sign_keypair();console.log('priv',Buffer.from(k.privateKey).toString('base64'));console.log('pub',Buffer.from(k.publicKey).toString('base64'))})"
MANDATEZ_PLATFORM_PRIVATE_KEY=
MANDATEZ_PLATFORM_PUBLIC_KEY=
