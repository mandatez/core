{
  "name": "n8n-nodes-mandatez",
  "version": "0.1.4",
  "description": "n8n community node for MandateZ — cryptographic audit trail and policy enforcement for AI agents",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ai",
    "agents",
    "audit",
    "compliance",
    "mandatez"
  ],
  "author": {
    "name": "MandateZ",
    "email": "okekemunachimsodavid@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://mandatez.mintlify.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mandatez/core.git",
    "directory": "packages/n8n-nodes-mandatez"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && cp nodes/MandateZ/mandatez.svg dist/nodes/MandateZ/mandatez.svg",
    "dev": "tsc --watch",
